# Dead Air Radio — Environment Variables
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; never commit real secrets.
#
# EXPO_PUBLIC_* vars are exposed to the client bundle at build time
# via the EAS build profile's `env` map (see eas.json) or via local `.env`.
#
# P6-6 (error tracking) wires Sentry at runtime; DSN lives in the
# production EAS profile so it ships only with release builds.
#
# P6-7 (analytics) injects the analytics key the same way.

# Backend / API proxy endpoint (omit if unused).
EXPO_PUBLIC_API_URL=https://api.deadair.example.com

# Sentry DSN (used by error tracking — see P6-6).
# Placeholder below; production value injected via EAS build profile or CI.
EXPO_PUBLIC_SENTRY_DSN=PROD_LOREM_IPSUM_DSN

# Analytics key (used by analytics layer — see P6-7).
EXPO_PUBLIC_ANALYTICS_KEY=PROD_LOREM_IPSUM_KEY
