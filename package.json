{
  "name": "dead-air",
  "version": "2.0.0",
  "private": true,
  "description": "Dead Air Radio \u2014 a paranormal late-night radio game.",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "assets": "python3 scripts/gen-assets.py",
    "audio": "python3 scripts/gen-audio.py"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.0",
    "expo-audio": "~56.0.13",
    "expo-font": "~56.0.5",
    "expo-insights": "~56.0.16",
    "expo-splash-screen": "~56.0.10",
    "expo-updates": "~56.0.18",
    "react": "19.2.3",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ],
    "moduleNameMapper": {
      "\\.(wav|png|jpg)$": "<rootDir>/__tests__/__mocks__/asset.js"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/__tests__/__mocks__/"
    ]
  }
}
