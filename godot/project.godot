; Engine configuration flags.
; Generated by initial project setup for Dead Air Radio Godot 4 rebuild.
; See: docs/plans/redesign-gdd.md (GDD is source truth)

config_version=5

[application]

config/name="Dead Air Radio"
config/description="Paranormal late-night radio game — Godot 4 rebuild"
run/main_scene=""
config/features=4.3
config/icon="res://icon.svg"

[autoload]

; DEA-152: Central input coordinator (singleton)
InputManager="*res://src/core/input_manager.gd"
; DEA-106: Phase state machine (singleton) — syncs with InputManager
PhaseManager="*res://src/core/phase_manager.gd"
; AudioBusManager — runtime bus volume control + ducking (DEA-134)
AudioBusManager="*res://src/audio/audio_bus_manager.gd"
; DEA-153: Save system autoloads
SaveManager="*res://src/core/save_manager.gd"
TapeInventory="*res://src/core/tape_inventory.gd"
; TapeSaveBridge — syncs TapeInventory with SaveData (tape collection system)
TapeSaveBridge="*res://src/core/tape_save_bridge.gd"
; DEA-108: Camera system coordinator (singleton)
CameraManager="*res://src/visual/camera_manager.gd"
; DEA-140: Silence & dead air event manager (singleton)
SilenceSystem="*res://src/audio/silence_system.gd"
; DEA-101: Stinger audio system (singleton)
StingerSystem="*res://src/audio/stinger_system.gd"
; Call/Transmission System autoloads
CallData="*res://src/data/call_data.gd"
CallManager="*res://src/core/call_manager.gd"
CallPlayer="*res://src/core/call_player.gd"
; StationState — shift tracking, degradation, wrongness events (singleton)
StationState="*res://src/core/station_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/use_debanding=true
anti_aliasing/quality/use_taa=true

[audio]

; 9-bus layout per GDD §Audio Architecture + TAPE bus for tape playback
; Buses: MASTER, ROOM_TONE, RADIO_AMBIENT, CALL_AUDIO, DREAD_LAYER, STINGER, SILENCE, UI, TAPE
; Default bus layout file: res://default_bus_layout.tres
bus/default_bus_layout="res://default_bus_layout.tres"

[input]

; DEA-152 Control Scheme — Issue #115 (authoritative)
; Gamepad: DualSense / Xbox button indices per Godot 4 JoyButton enum

; Movement — Left Stick (analog) + WASD (digital)
move_left={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0,"deadzone":0.5), Object(InputEventKey,"keycode":65,"unicode":97,"echo":false)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0,"deadzone":0.5), Object(InputEventKey,"keycode":68,"unicode":100,"echo":false)]
}
move_up={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0,"deadzone":0.5), Object(InputEventKey,"keycode":87,"unicode":119,"echo":false)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0,"deadzone":0.5), Object(InputEventKey,"keycode":83,"unicode":115,"echo":false)]
}

; Radio tuning — Right Stick X (explore mode) + Left Stick X (radio mode) + A/D keys
; DEA-97: Added Left Stick X and A,D keyboard for radio mode tuning per GDD spec
radio_tune_left={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0,"deadzone":0.5), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0,"deadzone":0.5), Object(InputEventKey,"keycode":65,"unicode":97,"echo":false)]
}
radio_tune_right={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0,"deadzone":0.5), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0,"deadzone":0.5), Object(InputEventKey,"keycode":68,"unicode":100,"echo":false)]
}

; Fine tune — L2/LT (axis 4) / Shift (hold modifier)
fine_tune={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0,"deadzone":0.5), Object(InputEventKey,"keycode":4194305,"unicode":0,"echo":false)]
}

; Interact — Cross/A (button 0) / E
interact={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":0,"pressed":true), Object(InputEventKey,"keycode":69,"unicode":101,"echo":false)]
}

; Record — Triangle/Y (button 3) / R (hold)
record={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":3,"pressed":true), Object(InputEventKey,"keycode":82,"unicode":114,"echo":false)]
}

; Play Tape — Square/X (button 2) / Q
play_tape={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":2,"pressed":true), Object(InputEventKey,"keycode":81,"unicode":113,"echo":false)]
}

; Hide — Circle/B (button 1) / Space (hold)
hide={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":1,"pressed":true), Object(InputEventKey,"keycode":32,"unicode":32,"echo":false)]
}

; Hold Breath — L2/LT (axis 4) / Ctrl (hold, while hiding)
hold_breath={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0,"deadzone":0.5), Object(InputEventKey,"keycode":4194306,"unicode":0,"echo":false)]
}

; Band Switch — L1 (button 9) / R1 (button 10)
band_prev={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":9,"pressed":true)]
}
band_next={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":10,"pressed":true)]
}

; Band Cycle — Tab
band_cycle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":258,"unicode":0,"echo":false)]
}

; Pause — Options/Start (button 6) / Esc
pause={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":6,"pressed":true), Object(InputEventKey,"keycode":27,"unicode":0,"echo":false)]
}

; Skip Call Text — Cross/A (button 0) / E (tap during call mode)
skip_call={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":0,"pressed":true), Object(InputEventKey,"keycode":69,"unicode":101,"echo":false)]
}

; Examine — D-pad Up (button 12) / F (hold to examine interactable)
examine={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":12,"pressed":true), Object(InputEventKey,"keycode":70,"unicode":102,"echo":false)]
}
