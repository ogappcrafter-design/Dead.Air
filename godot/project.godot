; Engine configuration flags.
; Generated by initial project setup for Dead Air Radio Godot 4 rebuild.
; See: docs/plans/redesign-gdd.md (GDD is source truth)

config_version=5

[application]

config/name="Dead Air Radio"
config/description="Paranormal late-night radio game — Godot 4 rebuild"
run/main_scene=""
config/features=4.3
config/icon="res://icon.svg"

[autoload]

; DEA-152: Central input coordinator (singleton)
InputManager="*res://src/core/input_manager.gd"
; DEA-106: Phase state machine (singleton) — syncs with InputManager
PhaseManager="*res://src/core/phase_manager.gd"
; AudioBusManager — runtime bus volume control + ducking (DEA-134)
AudioBusManager="*res://src/audio/audio_bus_manager.gd"
; DEA-153: Save system autoloads
SaveManager="*res://src/core/save_manager.gd"
TapeInventory="*res://src/core/tape_inventory.gd"
; TapeSaveBridge — syncs TapeInventory with SaveData (tape collection system)
TapeSaveBridge="*res://src/core/tape_save_bridge.gd"
; DEA-108: Camera system coordinator (singleton)
CameraManager="*res://src/visual/camera_manager.gd"
; DEA-140: Silence & dead air event manager (singleton)
SilenceSystem="*res://src/audio/silence_system.gd"
; DEA-101: Stinger audio system (singleton)
StingerSystem="*res://src/audio/stinger_system.gd"
; Call/Transmission System autoloads
CallData="*res://src/data/call_data.gd"
CallManager="*res://src/core/call_manager.gd"
CallPlayer="*res://src/core/call_player.gd"
; StationState — shift tracking, degradation, wrongness events (singleton)
StationState="*res://src/core/station_state.gd"
; StationDegradation — degradation/wrongness schedule for shifts 1-2 (singleton)
StationDegradation="*res://src/core/station_degradation.gd"
; ShiftController — shift lifecycle and progression (singleton)
ShiftController="*res://src/core/shift_controller.gd"
; BreatherSystem — breather events between calls (singleton)
BreatherSystem="*res://src/core/breather_system.gd"
; RecordingManager — radio tape recording, playback, and dangerous tape effects (singleton)
RecordingManager="*res://src/core/recording_manager.gd"
; BandController — band system controller (singleton)
BandController="*res://src/core/band_controller.gd"
; DEA-135: Room tone ambient system (singleton)
RoomToneSystem="*res://src/audio/room_tone_system.gd"
