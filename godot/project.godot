; Engine configuration flags.
; Generated by initial project setup for Dead Air Radio Godot 4 rebuild.
; See: docs/plans/redesign-gdd.md (GDD is source truth)

config_version=5

[application]

config/name="Dead Air Radio"
config/description="Paranormal late-night radio game — Godot 4 rebuild"
run/main_scene=""
config/features=4.3
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/use_debanding=true
anti_aliasing/quality/use_taa=true

[audio]

; 8-bus layout per GDD §Audio Architecture
; Buses: MASTER, ROOM_TONE, RADIO_AMBIENT, CALL_AUDIO, DREAD_LAYER, STINGER, SILENCE, UI
; Default bus layout file: res://default_bus_layout.tres
bus/default_bus_layout="res://default_bus_layout.tres"

[autoload]

; AudioBusManager — runtime bus volume control + ducking (DEA-134)
AudioBusManager="*res://src/audio/audio_bus_manager.gd"

[input]

; Radio actions (GDD §Controls / DEA-152)
radio_tune={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0,"deadzone":0.5), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0,"deadzone":0.5), Object(InputEventKey,"keycode":68,"unicode":100,"echo":false), Object(InputEventKey,"keycode":65,"unicode":97,"echo":false)]
}
radio_band_up={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":7,"pressed":true), Object(InputEventKey,"keycode":69,"unicode":101,"echo":false)]
}
radio_band_down={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":6,"pressed":true), Object(InputEventKey,"keycode":81,"unicode":113,"echo":false)]
}
radio_record={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":0,"pressed":true), Object(InputEventKey,"keycode":82,"unicode":114,"echo":false)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":2,"pressed":true), Object(InputEventKey,"keycode":69,"unicode":101,"echo":false), Object(InputEventKey,"keycode":32,"unicode":32,"echo":false)]
}
move={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0,"deadzone":0.5), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0,"deadzone":0.5), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0,"deadzone":0.5), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0,"deadzone":0.5), Object(InputEventKey,"keycode":87,"unicode":119,"echo":false), Object(InputEventKey,"keycode":83,"unicode":115,"echo":false), Object(InputEventKey,"keycode":65,"unicode":97,"echo":false), Object(InputEventKey,"keycode":68,"unicode":100,"echo":false)]
}
