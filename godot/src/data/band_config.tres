; band_config.tres — All 8 bands: 5 sacred + 3 extended (GDD v2 spec)
; Source: docs/plans/redesign-gdd.md GDD v2 Band Specs
; Godot 4 / format=3
[gd_resource type="Resource" script_class="BandConfig" load_steps=11 format=3]

[ext_resource type="Script" path="res://src/data/band_config.gd" id="1"]
[ext_resource type="Script" path="res://src/data/band_data.gd" id="2"]

[sub_resource type="Resource" id="Band_0"]
script = ExtResource("2")
id = 0
name = "LIVING"
freq = "88.7 FM"
color = 1.0, 0.55, 0.0, 1
unlock_at = 0
vibe = "Eerily normal callers. Mundane conversations that reveal something deeply wrong in the last line. Suburban horror. The banal made sinister."
center_frequency = 88.7
sensitivity = 8.0
freq_range_min = 87.5
freq_range_max = 92.0
drifts = false
drift_amount = 0.3
drift_interval = 30.0
unlock_type = 0
unlock_shift = 0
unlock_time_tuning_band = -1
unlock_time_seconds = 0.0
unlock_event_id = ""

[sub_resource type="Resource" id="Band_1"]
script = ExtResource("2")
id = 1
name = "LIMINAL"
freq = "102.3 FM"
color = 0.8, 1.0, 0.0, 1
unlock_at = 4
