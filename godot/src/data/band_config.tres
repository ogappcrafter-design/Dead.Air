; band_config.tres — All 8 bands: 5 sacred + 3 extended (DEA-149, DEA-97)
; Source: data/calls.js BANDS + BAND_VIBES + GDD radio tuning spec
; Godot 4 / format=3
[gd_resource type="Resource" script_class="BandConfig" load_steps=11 format=3]

[ext_resource type="Script" path="res://src/data/band_config.gd" id="1"]
[ext_resource type="Script" path="res://src/data/band_data.gd" id="2"]

[sub_resource type="Resource" id="Band_0"]
script = ExtResource("2")
id = 0
name = "LIVING"
freq = "88.7 FM"
color = 1, 0.549, 0, 1
unlock_at = 0
vibe = "Eerily normal callers. Mundane conversations that reveal something deeply wrong in the last line. Suburban horror. The banal made sinister."
center_frequency = 88.7
sensitivity = 8.0
freq_range_min = 87.5
freq_range_max = 92.0
drifts = false
drift_amount = 0.3
drift_interval = 30.0

[sub_resource type="Resource" id="Band_1"]
script = ExtResource("2")
id = 1
name = "LIMINAL"
freq = "94.0 FM"
color = 0.8, 1, 0, 1
unlock_at = 4
vibe = "Time loops, echoes, callers from repeated moments or wrong timelines. Liminal spaces between was and is."
center_frequency = 94.0
sensitivity = 6.0
freq_range_min = 92.0
freq_range_max = 96.5
drifts = false
drift_amount = 0.3
drift_interval = 30.0

