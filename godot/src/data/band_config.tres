[sub_resource type="Resource" id="Band_0"]
script = ExtResource("2")
id = 0
name = "LIVING"
freq = "98.0 FM"
color = 0, 1, 0, 1
unlock_at = 0
vibe = "Eerily normal callers. Mundane conversations that reveal something deeply wrong in the last line. Suburban horror. The banal made sinister."
center_frequency = 98.0
sensitivity = 8.0
freq_range_min = 88.0
freq_range_max = 108.0
drifts = false
drift_amount = 0.3
drift_interval = 30.0
unlock_type = 0
unlock_shift = 0
unlock_time_tuning_band = -1
unlock_time_seconds = 0.0
unlock_event_id = ""

